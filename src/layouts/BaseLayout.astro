---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Better Call Prabowo: a retro-web parody concept, independent of any official institution.",
} = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffce00" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
