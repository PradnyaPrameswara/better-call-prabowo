---
import { portrait, type PageId } from "../data/site";

interface Props { page: PageId }

const { page } = Astro.props;
const content: Record<PageId, { heading: string; intro: string; items: string[]; badge: string }> = {
  consultations: {
    heading: "BUTUH BANTUAN?",
    intro: "EMPAT CERITA PARODI NUSANTARA",
    items: ["KABAR PAGI", "CERITA WARGA", "SURAT TERBUKA", "KOPI SORE"],
    badge: "KONTEN VIDEO — TAHAP BERIKUTNYA",
  },
  testimonials: {
    heading: "KATA MEREKA!",
    intro: "TESTIMONI FIKTIF UNTUK KARYA PARODI",
    items: ["PAK BUDI", "BU SARI", "MAS JOKO"],
    badge: "TESTIMONI FIKTIF — SEGERA HADIR",
  },
  asseenontv: {
    heading: "SEPERTI DI TV!",
    intro: "TIGA PROMO PARODI RETRO",
    items: ["IKLAN PAGI", "IKLAN SIANG", "IKLAN MALAM"],
    badge: "VIDEO PARODI — SEGERA HADIR",
  },
  ecards: {
    heading: "KIRIM E-CARD!",
    intro: "EMPAT KARTU DIGITAL KONYOL",
    items: ["SALAM PAGI", "SEMANGAT!", "KOPI DULU", "SALAM NUSANTARA"],
    badge: "FORM & KARTU — TAHAP BERIKUTNYA",
  },
  livewebcam: {
    heading: "LIVE OFFICE CAM!",
    intro: "REKAMAN KANTOR FIKTIF",
    items: ["CAM 01 — RUANG KERJA"],
    badge: "SIMULASI WEBCAM — SEGERA HADIR",
  },
};
const current = content[page];
---
<section class="placeholder-panel" aria-labelledby="panel-heading">
  <h1 id="panel-heading" class="panel-heading">{current.heading}</h1>
  <div class="panel-row">
    <div class:list={["poster-grid", current.items.length === 1 && "single"]}>
      {current.items.map((item, index) => (
        <div class="poster-slot">
          <div class:list={["video-swatch", `swatch-${index + 1}`]}>
            <img src={portrait.src} alt="" width="150" height="108" loading={index === 0 ? "eager" : "lazy"} />
            <span class="swatch-label" aria-hidden="true">PRATINJAU</span>
          </div>
          <div class="video-title">{item}</div>
        </div>
      ))}
    </div>
    <aside class="panel-callout">
      <p>{current.intro}</p>
      <div class="panel-portrait">
        <img src={portrait.src} alt={portrait.alt} width="110" height="143" loading="lazy" />
      </div>
      <strong>PRABOWO<br />SUBIANTO</strong>
      <small>SITUS PARODI</small>
    </aside>
  </div>
  <p class="panel-status">{current.badge}</p>
</section>
