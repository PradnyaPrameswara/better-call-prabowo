---
import { sidebarPromotions } from "../data/site";
import { photos } from "../data/media";
---
<aside class="retro-sidebar" aria-label="Poster bergaya retro">
  <div class="sidebar-heading">PANGGIL SEKARANG!</div>
  <div class="sidebar-poster">
    <span class="poster-star">★</span>
    <strong>BETTER CALL<br />PRABOWO!</strong>
    <img src={photos.decoratedPortrait.url} alt="Potret Prabowo Subianto dengan tanda kehormatan" width="120" height="152" loading="lazy" />
    <span class="poster-caption">LIHAT VIDEO PILIHAN!</span>
  </div>
  {sidebarPromotions.map((promotion) => (
    <div class:list={["sidebar-ad", promotion.variation]}>
      <strong>{promotion.title}</strong>
      <small>{promotion.detail}</small>
    </div>
  ))}
</aside>
